# X-Plane Remote configuration.
# Run `npm run setup` to create .env from this file with freshly generated secrets.
# .env is git-ignored. Never commit real secrets.

# ---- App server -------------------------------------------------------------
# Keep HOST on loopback. Remote access goes through Tailscale Serve, which
# connects to this address locally. Do not use 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# ---- X-Plane Web API (must be a loopback URL) ---------------------------------
XPLANE_API_URL=http://127.0.0.1:8086
# Per-request timeout when talking to X-Plane.
XPLANE_REQUEST_TIMEOUT_MS=2000
# Telemetry is marked STALE when X-Plane has not answered for this long.
TELEMETRY_STALE_MS=3000
# How long to wait for X-Plane to confirm a pause/resume.
PAUSE_CONFIRM_TIMEOUT_MS=3000
# auto   = use sim/operation/pause_on / pause_off when present (idempotent), else pause_toggle
# toggle = always use sim/operation/pause_toggle (with state check before and after)
PAUSE_COMMAND_MODE=auto

# ---- WebFMC (must be a loopback URL) -----------------------------------------
WEBFMC_ENABLED=true
WEBFMC_URL=http://127.0.0.1:9090
# Optional: link shown as a fallback "open directly" button, e.g.
# http://my-pc.tailnet-name.ts.net:9090  (leave empty to hide the button)
WEBFMC_DIRECT_URL=

# ---- Authentication ----------------------------------------------------------
# APP_PASSWORD: what you type on the phone (min 12 chars).
# SESSION_SECRET: signs session cookies (min 32 chars). Changing either one
# signs out every device.
APP_PASSWORD=
SESSION_SECRET=
SESSION_TTL_HOURS=720

# ---- Request validation ------------------------------------------------------
# Host names the server answers to (protects against DNS rebinding).
# "*.ts.net" covers your Tailscale MagicDNS name.
ALLOWED_HOSTS=localhost,127.0.0.1,::1,*.ts.net
# auto = Secure cookie when the request arrived over HTTPS (Tailscale Serve)
COOKIE_SECURE=auto

# ---- Development -------------------------------------------------------------
# Mock simulator for UI development. NEVER live data. Off by default.
XPLANE_MOCK=false
LOG_LEVEL=info
